c MCNP6 AI Assistant 示例输入文件
c 简单的点源屏蔽计算示例
c ==================================

c 单元格卡片
c 1: 内部区域（空气）
c 2: 屏蔽层（铅）
c 3: 外部区域（真空）
1 1 -1.0e-24 -1 imp:p=1
2 2 -11.34 1 -2 imp:p=1
3 0 2 imp:p=0

c 表面卡片
c 1: 内球面，半径10 cm
c 2: 外球面，半径20 cm
1 so 10
2 so 20

c 材料卡片
c 材料1: 空气
m1 6000 0.000124 7014 0.755268 8016 0.231781 18040 0.012827

c 材料2: 铅
m2 82000 1.0

c 源定义
sdef pos=0 erg=1 par=2

c 计数卡
c F4: 面通量计数器
f4:n 2

c 运行控制卡
nps 100000
